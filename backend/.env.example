# Copy to .env (never commit .env). Generate secrets with: openssl rand -hex 32
PORT=3000
CORS_ORIGIN=http://localhost:8080
DATABASE_URL=postgres://scholar:CHANGE_ME@localhost:5432/scholarsetu
REDIS_URL=redis://localhost:6379
JWT_SECRET=
OTP_PEPPER=
# SMS gateway (leave SMS_API_URL empty in dev: OTP is printed in the console)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=
# DigiLocker partner credentials (from your DigiLocker partner onboarding)
DL_CLIENT_ID=
DL_CLIENT_SECRET=
DL_AUTH_URL=
DL_TOKEN_URL=
DL_REDIRECT_URI=http://localhost:3000/auth/digilocker/callback
